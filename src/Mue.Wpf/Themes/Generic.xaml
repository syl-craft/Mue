<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mue="clr-namespace:Mue.Wpf">
    <Style TargetType="{x:Type mue:UpdateBadge}">
        <Setter Property="FontFamily" Value="Consolas"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextDisabled}"/>
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.SurfaceCard}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="ToolTip" Value="{Binding Status, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Content" Value="{Binding VersionIndicator, RelativeSource={RelativeSource Self}}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type mue:UpdateBadge}">
                    <Border Background="Transparent">
                        <Border x:Name="Badge" Height="26" VerticalAlignment="Center" CornerRadius="13"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="HasRelease" Value="True"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions>
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.AccentTintStrong}"/>
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Badge" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions><Condition Property="HasRelease" Value="True"/><Condition Property="IsPressed" Value="True"/></MultiTrigger.Conditions>
                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource Brush.AccentSelected}"/>
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="HasRelease" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.AccentText}"/>
                <Setter Property="Background" Value="{DynamicResource Brush.AccentTint}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.AccentBorderSoft}"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="BorderThickness" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
