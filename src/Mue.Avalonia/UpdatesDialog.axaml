<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Mue;assembly=Mue" x:DataType="core:UpdateService" xmlns:mue="using:Mue.Avalonia" x:Class="Mue.Avalonia.UpdatesDialog"
        Title="{mue:T Update_Title}" Width="560" Height="480" MinWidth="440" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource Brush.Surface}"
        Foreground="{DynamicResource Brush.Text}" FontSize="13">
  <Window.Resources>
    <!-- Couleurs de la plume, posées par le code selon le fond (clair ou sombre). -->
    <SolidColorBrush x:Key="Mue.Credit.FeatherDark" Color="#B35C0A"/>
    <SolidColorBrush x:Key="Mue.Credit.FeatherLight" Color="#C9700F"/>
    <!-- Thème du lien de crédit, porté par un type propre : les styles de l'hôte qui visent Button ne s'y appliquent pas. -->
    <ControlTheme x:Key="Mue.CreditLink" TargetType="mue:CreditLinkButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Padding" Value="2,1"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Frame" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3"
                  Padding="{TemplateBinding Padding}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Viewbox Width="14" Height="14" VerticalAlignment="Center">
                <Canvas Width="256" Height="256">
                  <Path Fill="{DynamicResource Mue.Credit.FeatherDark}">
                    <Path.Data>
                      <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1><StreamGeometry>M118,14 C64,56 48,154 118,206 Z</StreamGeometry></CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                          <GeometryGroup>
                            <StreamGeometry>M157.5,161 L9,81.1 L0.5,97 L149,176.9 Z</StreamGeometry>
                            <StreamGeometry>M105.5,132.9 L256.1,63.4 L248.5,47.1 L97.9,116.6 Z</StreamGeometry>
                          </GeometryGroup>
                        </CombinedGeometry.Geometry2>
                      </CombinedGeometry>
                    </Path.Data>
                  </Path>
                  <Path Fill="{DynamicResource Mue.Credit.FeatherLight}">
                    <Path.Data>
                      <CombinedGeometry GeometryCombineMode="Exclude">
                        <CombinedGeometry.Geometry1><StreamGeometry>M138,14 C188,62 200,154 138,206 Z</StreamGeometry></CombinedGeometry.Geometry1>
                        <CombinedGeometry.Geometry2>
                          <GeometryGroup>
                            <StreamGeometry>M157.5,161 L9,81.1 L0.5,97 L149,176.9 Z</StreamGeometry>
                            <StreamGeometry>M105.5,132.9 L256.1,63.4 L248.5,47.1 L97.9,116.6 Z</StreamGeometry>
                          </GeometryGroup>
                        </CombinedGeometry.Geometry2>
                      </CombinedGeometry>
                    </Path.Data>
                  </Path>
                  <Rectangle Canvas.Left="118" Canvas.Top="210" Width="20" Height="34" RadiusX="10" RadiusY="10"
                             Fill="{DynamicResource Mue.Credit.FeatherDark}"/>
                </Canvas>
              </Viewbox>
              <TextBlock Name="Label" Text="{TemplateBinding Content}" FontSize="11" VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.TextSubtle}"/>
            </StackPanel>
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover /template/ TextBlock#Label"><Setter Property="TextDecorations" Value="Underline"/></Style>
      <Style Selector="^:focus-visible /template/ TextBlock#Label"><Setter Property="TextDecorations" Value="Underline"/></Style>
      <Style Selector="^:focus-visible /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/></Style>
    </ControlTheme>
  </Window.Resources>
  <Grid RowDefinitions="Auto,*,Auto,Auto">
    <StackPanel Margin="20,16,20,10" Spacing="6">
      <TextBlock Name="StateLabel" Text="{Binding StateLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextLabel}"/>
      <TextBlock Text="{Binding Heading}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <DockPanel Margin="0,4,0,0" LastChildFill="True">
        <Button DockPanel.Dock="Right" Content="{mue:T Update_GitHub}" Theme="{DynamicResource SecondaryButton}"
                Click="GitHub_Click" FontSize="12" Padding="6,3" Margin="8,0,0,0"/>
        <WrapPanel VerticalAlignment="Center">
          <Border Background="{DynamicResource Brush.SurfaceMuted}" CornerRadius="10" Padding="8,2">
            <TextBlock Text="{Binding CurrentVersion}" FontFamily="Consolas" Foreground="{DynamicResource Brush.TextLabel}"/>
          </Border>
          <StackPanel Orientation="Horizontal" IsVisible="{Binding HasRelease}">
            <TextBlock Text="→" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextDetail}"/>
            <Border Background="{DynamicResource Brush.AccentSelected}" CornerRadius="10" Padding="8,2">
              <TextBlock Text="{Binding NewVersion}" FontFamily="Consolas" FontWeight="SemiBold" Foreground="{DynamicResource Brush.AccentText}"/>
            </Border>
          </StackPanel>
          <TextBlock Text="{Binding ReleaseMetadata}" Margin="8,2,0,0" Foreground="{DynamicResource Brush.TextSubtle}" TextWrapping="Wrap"/>
        </WrapPanel>
      </DockPanel>
      <Border Name="StatusBanner" Margin="0,4,0,0" Padding="12,8" CornerRadius="6" BorderThickness="1"
              Background="{DynamicResource Brush.SurfaceCard}" BorderBrush="{DynamicResource Brush.Border}">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
      </Border>
      <StackPanel IsVisible="{Binding ShowsProgress}" Spacing="4">
        <ProgressBar Height="4" Minimum="0" Maximum="100" Value="{Binding Progress}"
                     Foreground="{DynamicResource Brush.Accent}" Background="{DynamicResource Brush.Border}"
                     IsIndeterminate="{Binding IsIndeterminate}" AutomationProperties.Name="{mue:T Update_Progress}"/>
        <TextBlock IsVisible="{Binding IsDownloading}" Text="{Binding DownloadSize}" FontSize="12" Foreground="{DynamicResource Brush.TextLabel}"/>
      </StackPanel>
    </StackPanel>
    <Border Grid.Row="1" Margin="20,0,20,10" Padding="12,8" CornerRadius="6" IsVisible="{Binding HasRelease}"
            Background="{DynamicResource Brush.SurfaceCard}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
      <Grid RowDefinitions="Auto,*">
        <TextBlock Text="{mue:T Update_Notes}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextLabel}" Margin="0,0,0,6"/>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Name="NotesBlocks"/>
        </ScrollViewer>
      </Grid>
    </Border>
    <TextBlock Name="PreparationSummary" Grid.Row="2" IsVisible="False" TextWrapping="Wrap" Margin="20,0,20,10"
               AutomationProperties.LiveSetting="Polite"/>
    <Border Grid.Row="3" Name="Footer" Theme="{DynamicResource DialogFooter}" Padding="20,10">
      <StackPanel Spacing="8">
        <Grid ColumnDefinitions="*,Auto">
          <CheckBox Name="Automatic" Content="{mue:T Update_Automatic}" IsChecked="{Binding Automatic, Mode=TwoWay}" FontSize="12" MinHeight="24"/>
          <TextBlock Name="LastChecked" Grid.Column="1" Text="{Binding LastChecked}" FontSize="11"
                     Foreground="{DynamicResource Brush.TextSubtle}" VerticalAlignment="Center" Margin="8,0,0,0"/>
        </Grid>
        <Grid ColumnDefinitions="*,Auto">
          <mue:CreditLinkButton Name="CreditLink" Theme="{StaticResource Mue.CreditLink}" Content="{mue:T Update_Credit}"
                                VerticalAlignment="Center" HorizontalAlignment="Left" Click="Credit_Click"/>
          <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
            <Button Name="SecondaryButton" Theme="{DynamicResource SecondaryButton}"
                    IsEnabled="{Binding SecondaryEnabled}" Click="Secondary_Click" Margin="0,0,8,0"/>
            <Button Name="InstallButton" Theme="{DynamicResource PrimaryButton}"
                    IsEnabled="{Binding PrimaryEnabled}" Click="Primary_Click"/>
          </WrapPanel>
        </Grid>
      </StackPanel>
    </Border>
  </Grid>
</Window>
